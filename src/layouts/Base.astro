---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t, langPath } from "../lib/i18n";
import type { Lang } from "../lib/config";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  path?: string;
}

const { lang, title, description, path = "" } = Astro.props;
const messages = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const desc = description ?? messages.meta.description;
const canonical = new URL(langPath(lang, path, base), Astro.site);
const og = new URL(`${base}/og.jpg`, Astro.site);
---

<!doctype html>
<html lang={lang === "ne" ? "ne" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {messages.meta.siteName}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#b42318" />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={`${title} · ${messages.meta.siteName}`} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={og.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#content">{messages.nav.skip}</a>
    <Header lang={lang} path={path} />
    <main id="content">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer lang={lang} />
    <script>
      const key = "netgalchi-lang";
      const htmlLang = document.documentElement.lang;
      const stored = htmlLang.startsWith("ne") ? "ne" : "en";
      try {
        localStorage.setItem(key, stored);
      } catch {
        /* ignore */
      }
    </script>
  </body>
</html>
