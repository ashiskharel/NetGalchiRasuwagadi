---
import { langPath } from "../lib/i18n";
import { t } from "../lib/i18n";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const en = langPath("en", "", base);
const ne = langPath("ne", "", base);
const messages = t("en");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{messages.meta.siteName}</title>
    <meta name="description" content={messages.meta.description} />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="ne" href={ne} />
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${en}`} />
    </noscript>
    <style>
      body {
        font-family: system-ui, "Noto Sans Devanagari", sans-serif;
        background: #f4efe6;
        color: #1a1a18;
        max-width: 36rem;
        margin: 3rem auto;
        padding: 0 1rem;
      }
      a {
        display: inline-block;
        margin: 0.4rem 0.6rem 0 0;
        padding: 0.6rem 0.9rem;
        background: #b42318;
        color: #fff;
        text-decoration: none;
        border-radius: 0.35rem;
        min-height: 44px;
      }
    </style>
  </head>
  <body>
    <h1>{messages.meta.siteName}</h1>
    <p>{messages.root.choose}</p>
    <p>
      <a href={en} lang="en">English</a>
      <a href={ne} lang="ne">नेपाली</a>
    </p>
    <script define:vars={{ en, ne }}>
      const key = "netgalchi-lang";
      let lang = "en";
      try {
        const stored = localStorage.getItem(key);
        if (stored === "ne" || stored === "en") lang = stored;
        else lang = (navigator.language || "").toLowerCase().startsWith("ne") ? "ne" : "en";
      } catch {
        lang = "en";
      }
      location.replace(lang === "ne" ? ne : en);
    </script>
  </body>
</html>
