---
import Base from "../../layouts/Base.astro";
import { LANGS, isLang, type Lang } from "../../lib/config";
import { t } from "../../lib/i18n";
import snapshot from "../../data/snapshot.json";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error("bad lang");
const lang: Lang = langParam;
const messages = t(lang);
const start = snapshot.incident.started;
const pre = "2026-08-25";
const today = new Date().toISOString().slice(0, 10);
const worldview = `https://worldview.earthdata.nasa.gov/?v=84.85,27.72,85.72,28.52&l=VIIRS_SNPP_CorrectedReflectance_TrueColor,Coastlines_15m&t=${start}-T00%3A00%3A00Z`;
const copernicus = `https://browser.dataspace.copernicus.eu/?zoom=11&lat=28.11&lng=85.30&datasetId=S2_L2A_CDAS&fromTime=${pre}T00:00:00.000Z&toTime=${today}T23:59:59.999Z`;
const ui = {
  loading: messages.satellites.loading,
  error: messages.satellites.error,
  noneNear: messages.satellites.noneNear,
  altKm: messages.satellites.altKm,
  elev: messages.satellites.elev,
  az: messages.satellites.az,
  leo: messages.satellites.leo,
  geo: messages.satellites.geo,
};
const asf = `https://search.asf.alaska.edu/#/?dataset=SENTINEL-1&productTypes=GRD_HD&start=${pre}&resultsLoaded=true&zoom=8.5&center=85.320,28.110`;
const copernicusS1 = `https://browser.dataspace.copernicus.eu/?zoom=11&lat=28.11&lng=85.30&datasetId=S1_GRD_IW_CDAS&fromTime=${pre}T00:00:00.000Z&toTime=${today}T23:59:59.999Z`;
---

<Base lang={lang} title={messages.satellites.title} path="satellites">
  <h1>{messages.satellites.title}</h1>
  <p class="lead">{messages.satellites.lead}</p>
  <div class="callout">
    <strong>{messages.satellites.caveatTitle}</strong>
    <p style="margin: 0.35rem 0 0;">{messages.satellites.caveat}</p>
  </div>

  <h2>{messages.satellites.imageryTitle}</h2>
  <p class="note">{messages.satellites.imageryHint}</p>
  <div class="sat-controls">
    <label>
      {messages.satellites.date}
      <input id="sat-date" type="date" min={pre} max={today} value={start} />
    </label>
    <button type="button" class="btn secondary" id="sat-prev">{messages.satellites.prev}</button>
    <button type="button" class="btn secondary" id="sat-next">{messages.satellites.next}</button>
    <button type="button" class="btn" id="sat-play" data-play={messages.satellites.play} data-stop={messages.satellites.stop}>
      {messages.satellites.play}
    </button>
  </div>
  <div
    id="sat-map"
    class="map"
    data-start={start}
    data-pre={pre}
    data-base={import.meta.env.BASE_URL.replace(/\/$/, "")}
  >
  </div>

  <h2>{messages.satellites.s1Title}</h2>
  <p class="note">{messages.satellites.s1Hint}</p>
  <div id="s1-stills" class="s1-strip" data-empty={messages.satellites.s1None}></div>

  <h2>{messages.satellites.liveTitle}</h2>
  <p class="note">{messages.satellites.liveHint}</p>
  <div id="sat-live" data-ui={JSON.stringify(ui)}>
    <p class="note">{messages.satellites.loading}</p>
  </div>

  <h2>{messages.satellites.tools}</h2>
  <ul class="list-plain">
    <li><a href={worldview}>{messages.satellites.worldview}</a></li>
    <li><a href={copernicus}>{messages.satellites.copernicus}</a></li>
    <li><a href={copernicusS1}>{messages.satellites.copernicusS1}</a></li>
    <li><a href={asf}>{messages.satellites.asf}</a></li>
  </ul>
  <p class="asof">{messages.satellites.credit}</p>
</Base>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  import "../../scripts/satellites-map.ts";
</script>
